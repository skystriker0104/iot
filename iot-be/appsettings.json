{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=IotDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "iot-server",
    "Audience": "iot-web",
    "Key": "CHANGE_ME",
    "ExpireMinutes": 120
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1884,
    "Username": "",
    "Password": "",
    "ClientId": "iot-server",
    "BaseTopic": "iot/esp8266_01",
    "SensorSaveIntervalSeconds": 2,
    "ControlTimeoutSeconds": 5
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
